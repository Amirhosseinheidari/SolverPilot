# DISABLED TEMPLATE — rename to .yml only after M33 external gates and owner metadata pass.
name: M33 publish to PyPI

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    environment:
      name: pypi
      # url: https://pypi.org/p/OWNER_APPROVED_PROJECT_NAME
    permissions:
      id-token: write
    steps:
      - name: Download externally qualified release distributions
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: m33-dist
          path: dist
      - name: Publish via PyPI Trusted Publishing
        uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33 # v1.14.2
        with:
          packages-dir: dist/
